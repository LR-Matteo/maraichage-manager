{
  "name": "maraichage-manager",
  "version": "1.0.0",
  "description": "Application de gestion de maraichage",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build-win": "electron-builder --win --publish never",
    "publish-win": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.maraichage.manager",
    "productName": "Maraichage Manager",
    "forceCodeSigning": false,
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "LR-Matteo",
      "repo": "maraichage-manager"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maraichage Manager"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "dependencies": {
    "express": "^4.21.0",
    "sql.js": "^1.11.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  }
}
